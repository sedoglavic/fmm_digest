{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/format-rank-table.json",
  "title": "Format-Rank Table (unordered formats)",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "source": {
		"type": "string",
      		"format": "uri",
      		"description": "URL of a website presenting/documenting this data."
    	},
    "contributor": {
      		"type": "string",
      		"description": "The contributor's 16-digit ORCID iD in full URI or standard hyphenated format.",
      		"pattern": "^(https://orcid\\.org/)?\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "The ISO 8601 date and time when this JSON data file was created."
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" },
      "uniqueItems": true
    }
  },
  "required": ["entries","contributor","CreatedAt"],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "format": {
          "type": "array",
          "description": "Unordered triple of positive integers, stored sorted ascending by convention so equivalent formats have a unique representation.",
          "items": { "type": "integer", "minimum": 2 },
          "minItems": 3,
          "maxItems": 3
        },
        "rank": {
          "type": "integer",
          "minimum": 7
        },
        "exponent": {
          "type": "number",
          "minimum": 2,
          "maximum": 3,
          "description": "Exponent of matrix multiplication complexity for this format."
        }
      },
      "required": ["format", "rank", "exponent"],
      "additionalProperties": false
    }
  }
}
